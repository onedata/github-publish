#!/usr/bin/env python

from __future__ import print_function

import sys
import subprocess
import yaml
from yamllint import linter
from yamllint.config import YamlLintConfig, YamlLintConfigError


f = open('config.yml')

print("Validating config file... ",end="")
problems = linter.run(f,YamlLintConfig('extends: default'))

has_problems=False
found_deduplication=False
for problem in problems:
  has_problems=True
  print(problem)
  if "duplication" in str(problem):
    found_deduplication=True

if not has_problems:
   print('no problems found.')

if found_deduplication:
  print("Duplicated entires in config, exitting...")
  sys.exit(-1)

f = open('config.yml')
repos = yaml.load(f)

repo_num=0;
failed_repos=[]
for repo_name, repo in repos.iteritems():
  repo_num+=1
  try:
    status=subprocess.call([
    "bash","-c",
    "printf 'Processing {}/{} {}: ' ; ".format(repo_num,len(repos),repo_name)+
    "bin/sr-publish {} -s {} -d {} -b '{}' -t '{}' --tmp-dir /tmp --src-key {} --dest-key {}".format(" ".join(map(str,sys.argv[1:])),
    repo["src"],
    repo["dst"],
     '%s' % ' '.join(map(str,repo["branches"])) if 'branches' in repo else "",
     '%s' % ' '.join(map(str,repo["tags"])) if 'tags' in repo else "",
    repo["sid"],
    repo["did"])
    ])
  except (KeyError, TypeError) as e:
    # an entry that lacks a key fails alone, and the pass goes on to the next one
    print("Processing {}/{} {}: broken entry: {!r}".format(repo_num,len(repos),repo_name,e))
    status=1
  if status != 0:
    failed_repos.append(repo_name)

if failed_repos:
  print("Failed to publish {} of {} repos: {}".format(len(failed_repos),len(repos),", ".join(failed_repos)))
  sys.exit(1)
